# ── Claude Code (local AI tooling, not source code) ──────────────
.claude/

# ── Miscellaneous ────────────────────────────────────────────────
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# ── IntelliJ / Android Studio ────────────────────────────────────
*.iml
*.ipr
*.iws
.idea/

# ── VS Code ──────────────────────────────────────────────────────
# Uncomment the line below if you do NOT want to share your VS Code
# launch/debug config with others. Leave commented to share it.
#.vscode/

# ── Flutter / Dart / Pub ─────────────────────────────────────────
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
.packages

# ── Build output (never commit these) ────────────────────────────
/build/
/coverage/

# ── Hive generated database files (user data, not source code) ───
*.hive
*.lock

# ── Hive generated adapter files (auto-generated, DO commit) ─────
# These are generated by build_runner and should be committed
# so others don't need to run build_runner themselves:
# lib/models/character.g.dart   <-- KEEP (commit this)
# lib/models/collection.g.dart  <-- KEEP (commit this)
!lib/models/*.g.dart

# ── Symbolication / Obfuscation ──────────────────────────────────
app.*.symbols
app.*.map.json

# ── Android build artifacts ──────────────────────────────────────
/android/app/debug
/android/app/profile
/android/app/release

# ── Windows build artifacts ──────────────────────────────────────
/windows/flutter/generated_plugin_registrant.cc
/windows/flutter/generated_plugin_registrant.h
/windows/flutter/generated_plugins.cmake
